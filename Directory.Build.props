<!-- Properties shared by every project in this repository.
     The file also shields the repository from a consumer's own
     Directory.Build.props when it is checked out inside another tree:
     MSBuild walks up until it finds the first such file and stops there. -->
<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Company>BIMzen</Company>
    <Product>Bcf.Core</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
</Project>
