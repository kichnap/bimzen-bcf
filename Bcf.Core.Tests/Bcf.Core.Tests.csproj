<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Две цели намеренно: net48 — как в Navisworks, net8.0 — как у будущего
         агента. Один и тот же netstandard2.0 обязан работать в обоих хостах. -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bcf.Core.Tests</RootNamespace>
    <!-- CA1707: имена тестов пишутся как Метод_Условие_Ожидание, подчёркивания здесь осмысленны.
         Остальные — советы использовать API, которых нет в net48: проект собирается
         на две цели, и писать разный код под каждую ради стиля незачем. -->
    <NoWarn>$(NoWarn);CA1510;CA1707;CA1825;CA1861;CA1865;CA2249</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <!-- Только в тестах: справочник разбирается заново и сверяется со
         сгенерированными константами. В самой Bcf.Core JSON-парсера нет. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- В net48 сборки работы с ZIP не подключаются автоматически, в отличие
         от netstandard2.0. Именно так это выглядит и в плагине под Navisworks -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bcf.Core\Bcf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Генератор компилируется прямо в тесты: тест генерирует константы заново
         и сверяет с закоммиченным файлом, поэтому расхождение справочника
         и кода ловится тестом, а не в рантайме. Ссылкой на проект это сделать
         нельзя — генератор собирается только под net8.0. -->
    <Compile Include="..\Bcf.Vocabulary.Generator\VocabularyCodeGenerator.cs" Link="Generator\VocabularyCodeGenerator.cs" />
    <Compile Include="..\Bcf.Vocabulary.Generator\RepositoryPaths.cs" Link="Generator\RepositoryPaths.cs" />
  </ItemGroup>

</Project>
